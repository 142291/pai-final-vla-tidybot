# コピーして config.env を作り、lerobot-find-port で判明したポートに書き換える
FOLLOWER_PORT=/dev/tty.usbmodemXXXXXXXX
LEADER_PORT=/dev/tty.usbmodemYYYYYYYY
FOLLOWER_ID=so101_follower_01
LEADER_ID=so101_leader_01
# lerobot-find-cameras opencv で判明したカメラ index に合わせる
CAMERAS='{ front: {type: opencv, index_or_path: 0, width: 640, height: 480, fps: 30} }'
# Hugging Face は任意。ローカル保存のみなら空でよい
HF_USER=
